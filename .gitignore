# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local env
.env.local

# Personal instructions to the coding agent. AGENTS.md stays tracked --
# it is the project contract; this file is whatever you want it to be.
CLAUDE.md

# Personal, one-time data imports. One person's history, run by hand in the
# Supabase SQL Editor -- never schema, never replayed on another database.
supabase/personal/

# eval harness: raw API responses, re-scoreable, not worth versioning
/scripts/eval/runs/
